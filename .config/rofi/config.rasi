configuration{
    modi: "run,window,combi";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " 🖥️  All ";
    display-run: " 🏃  Run ";
    display-window: " 🪟  Window";
    sidebar-mode: false;
}

// @theme "catppuccin-mocha"

//@theme "/usr/share/rofi/themes/material.rasi"

@theme "~/.config/rofi/rounded-blue-dark.rasi"
