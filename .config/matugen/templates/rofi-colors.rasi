/* Gerado pelo matugen a partir do wallpaper. Não edite: é sobrescrito a cada troca de tema. */
* {
    bg0: {{colors.surface.default.hex}}F2;
    bg1: {{colors.surface_container.default.hex}};
    bg2: {{colors.surface_container_highest.default.hex}}80;
    bg3: {{colors.primary.default.hex}};
    fg0: {{colors.on_surface.default.hex}};
    fg1: {{colors.on_primary.default.hex}};
    fg2: {{colors.on_surface_variant.default.hex}};
    fg3: {{colors.outline.default.hex}};
}
